# /etc/systemd/system/howgo.service
[Unit]
Description=HowGo IM (Node)
After=network.target

[Service]
Type=simple
User=howgo
Group=howgo
WorkingDirectory=/opt/howgo
EnvironmentFile=/etc/howgo/howgo.env
ExecStart=/usr/bin/node /opt/howgo/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/howgo/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
