# /etc/howgo/howgo.env  —— 权限建议 640 root:howgo
PORT=5210
HOWGO_PUBLIC_URL=https://howgo.laswi.com.cn

# LaswI ID（OAuth2 授权码模式，服务端换取 token）
LASWI_CLIENT_ID=
LASWI_CLIENT_SECRET=
LASWI_AUTH_BASE=https://rtuser.rtstudio.top
LASWI_AUTHORIZE_PATH=/auth/authorize
LASWI_TOKEN_PATH=/auth/token
LASWI_USER_PATH=/auth/get-user
LASWI_SCOPE=openid profile

# 管理员密钥（第二因素）；不设则首次启动随机生成到 data/admin-key.txt
HOWGO_ADMIN_KEY=
